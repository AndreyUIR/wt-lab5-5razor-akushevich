@page
@model CreateModel
@{
    ViewData["Title"] = "Добавление счёта";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="mb-4">Добавление счёта</h2>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Account.OwnerName" class="form-label">Владелец</label>
                            <input asp-for="Account.OwnerName" class="form-control" />
                            <span asp-validation-for="Account.OwnerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Account.AccountNumber" class="form-label">Номер счёта</label>
                            <input asp-for="Account.AccountNumber" class="form-control" />
                            <span asp-validation-for="Account.AccountNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Account.Balance" class="form-label">Начальный баланс (BYN)</label>
                            <input asp-for="Account.Balance" class="form-control" />
                            <span asp-validation-for="Account.Balance" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <a asp-page="./Index" class="btn btn-secondary">Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}