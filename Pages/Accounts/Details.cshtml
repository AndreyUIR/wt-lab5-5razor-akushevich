@page
@model DetailsModel
@{
    ViewData["Title"] = "Счёт " + Model.Account.AccountNumber;
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4 mx-auto" style="max-width: 540px;">
        <div class="card-body p-4">
            <h2 class="mb-3">Счёт @Model.Account.AccountNumber</h2>

            <p><strong>ID:</strong> @Model.Account.Id</p>
            <p><strong>Владелец:</strong> @Model.Account.OwnerName</p>
            <p><strong>Номер счёта:</strong> @Model.Account.AccountNumber</p>
            <p><strong>Баланс:</strong> @Model.Account.Balance.ToString("N2") BYN</p>
            <p>
                <strong>Статус:</strong>
                @if (Model.Account.IsActive)
                {
                    <span class="badge bg-success">Активен</span>
                }
                else
                {
                    <span class="badge bg-danger">Закрыт</span>
                }
            </p>

            <div class="d-flex gap-2">
                <a asp-page="./Edit" asp-route-id="@Model.Account.Id" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Изменить
                </a>
                <a asp-page="./Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>